# Copie para .env na raiz do repositório. Nunca commitar o arquivo .env.
# Portas de host não padrão — ver docs/DEVELOPMENT.md

DATABASE_URL=postgresql+asyncpg://aca:aca@localhost:55432/aca
REDIS_URL=redis://localhost:56379/0

OPENAI_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PROVIDER=openai
AUDIO_STORAGE_PATH=storage/audio

# RAG adaptativo (D-03: limites 2k / 10k — ajustáveis após testes)
RAG_DIRECT_MAX_MESSAGES=2000
RAG_SUMMARY_MAX_MESSAGES=10000
RAG_CHUNK_SIZE=8
RAG_TOP_K=12
RAG_INTERMEDIATE_MAX_MESSAGES=800
RAG_INTERMEDIATE_RECENT_MESSAGES=400
EMBEDDING_BATCH_SIZE=64

JWT_SECRET=change-me-in-development-min-32-bytes
JWT_EXPIRE_MINUTES=1440

MAX_UPLOAD_BYTES=52428800
IMPORT_BATCH_SIZE=500
